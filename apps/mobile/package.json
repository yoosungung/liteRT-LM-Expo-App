{
  "name": "mobile",
  "version": "0.0.1",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "JAVA_HOME=\"${JAVA_HOME:-/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home}\" expo run:android --device liteRTLM_E2B",
    "ios": "expo run:ios",
    "web": "expo start --web",
